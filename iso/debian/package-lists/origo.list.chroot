# Origo v0.1 package list (installed in the live system / chroot)
# Minimal Xfce desktop + graphical installer + Origo agent dependencies

# Live system runtime: create user/password and graphical autologin at boot.
# (components are listed explicitly because --apt-recommends is false;
#  in trixie the X11 autologin components live inside the live-config package)
live-boot
live-config
live-config-systemd
live-tools

# Minimal desktop
xfce4
xfce4-terminal
xfce4-settings
xfce4-power-manager
lightdm
lightdm-gtk-greeter
xserver-xorg-core
xserver-xorg-input-libinput
network-manager
network-manager-gnome
pipewire
pipewire-audio
wireplumber
fonts-wqy-zenhei
fonts-noto-core
dbus-x11
polkitd
lxpolkit
xdg-utils

# Settings panel backends (so the settings skill works on Xfce)
pavucontrol
blueman
arandr

# Graphical installer
calamares
calamares-settings-debian

# Origo agent runtime (python3-requests / python3-rich cover dependencies)
python3
python3-requests
python3-rich
python3-pip
python3-venv

# Utilities
git
curl
wget
gnupg
ca-certificates
sudo
less
usbutils
pciutils
file
man-db

# Firmware / hardware support (non-free-firmware archive area)
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-ath9k-htc
